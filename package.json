{
  "name": "alifway-media-cinematic",
  "version": "0.1.0",
  "private": true,
  "main": "dist/standalone/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "node dist/standalone/server.js",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "js-yaml": "4.3.1",
    "miniflare": "5.20260801.0-alpha",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "postcss": "8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "undici": "7.29.0",
    "miniflare": {
      "undici": "7.29.0"
    },
    "wrangler": {
      "miniflare": "5.20260801.0-alpha",
      "undici": "7.29.0"
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@cloudflare/vite-plugin": "1.51.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "brace-expansion": "5.0.9",
    "drizzle-kit": "0.18.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "fast-uri": "3.1.5",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "undici": "7.29.0",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "ws": "8.21.0"
  },
  "type": "module",
  "displayName": "Alifway Media — Scroll Cinematic"
}
